# Browser-visible Google Maps Map Tiles API key (optional).
# Enable Map Tiles API, restrict API and HTTP referrers in Google Cloud.
# Restrict to http://127.0.0.1:3100/* and http://localhost:3100/* for this local app.
# Set an API quota before enabling Google; free usage is limited, not unlimited.
# Copy to .env.local, supply your own key, then rebuild and restart.
NEXT_PUBLIC_GOOGLE_MAPS_TILE_API_KEY=

# Optional canonical origin for request validation (for example https://map.example.vn).
# Internet launch also requires persistent shared storage and abuse protection.
TTXD_PUBLIC_ORIGIN=

# Cloud hosting requires Supabase. Keep all these values server-side.
TTXD_STORAGE_BACKEND=sqlite
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Base64 encoding of the EXISTING 32-byte data/secret.key; never generate a replacement.
TTXD_ENCRYPTION_KEY=
