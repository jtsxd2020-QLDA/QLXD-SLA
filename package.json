{
  "name": "quan-ly-ttxd-tinh-son-la",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "postinstall": "node scripts/prepare-map.mjs",
    "prebuild": "node scripts/prepare-map.mjs",
    "data:migrate": "node --env-file=.env.cloud.local --import tsx scripts/migrate-supabase.ts",
    "cloud:verify": "node --env-file=.env.cloud.local --import tsx scripts/verify-cloud.ts",
    "test:e2e:upgrade": "tsx scripts/e2e-upgrade.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "exceljs": "4.4.0",
    "lucide-react": "1.16.0",
    "maplibre-gl": "6.13.0",
    "next": "16.4.0",
    "pdfkit": "0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "1.60.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
